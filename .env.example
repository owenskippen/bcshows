# Environment Variables - Copy and rename to .env

# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# DynamoDB Tables
DYNAMODB_SHOWS_TABLE=CardShows
DYNAMODB_LOCATIONS_TABLE=Locations
DYNAMODB_SCRAPE_LOG_TABLE=ScrapeLog

# Cognito
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_client_id
COGNITO_REGION=us-west-2

# Frontend API
VITE_API_BASE_URL=http://localhost:3001

# Scraper Configuration
SCRAPER_ENABLED_SOURCES=tcdb
TCDB_SCRAPER_ENABLED=true
TCDB_SCRAPER_SCHEDULE=0 3 * * 1,3,5
SCRAPER_REQUEST_DELAY_MIN=2000
SCRAPER_REQUEST_DELAY_MAX=5000
SCRAPER_MAX_RETRIES=3

# Application
NODE_ENV=development
DEBUG=false
